# Python environment (rebuilt per-machine by `uv sync`)
.venv/
__pycache__/
*.pyc

# Built app bundle (rebuilt per-machine by build_app.sh / setup.sh)
Voice To Text.app/

# Personal / machine-specific runtime data — never commit
voice-to-text.log
history.jsonl
prosody_baseline.json
.show_settings
.onboarded

# Personal config override (cloud endpoint, etc.) — deep-merges over config.toml.
# Keeps the committed config.toml a clean local default; your cloud settings and
# any keys stay on your machine only.
config.local.toml

# macOS
.DS_Store
.gstack/

# Real-voice accuracy test recordings (personal audio)
experiments/voice_test_recordings/
.vercel
